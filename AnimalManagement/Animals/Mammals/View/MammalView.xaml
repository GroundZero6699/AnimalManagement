<Window x:Class="AnimalManagement.Animals.Mammals.MammalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalManagement.Animals.Mammals"
        xmlns:common="clr-namespace:AnimalManagement.Animals.Common"
        xmlns:view="clr-namespace:AnimalManagement.Animals.Mammals.View"
        mc:Ignorable="d"
        Title="MammalView" Height="450" Width="400">
    
    <!-- Templates for specific data fields -->
    <Window.Resources>
        
        <!-- Template for textfields -->
        <DataTemplate x:Key="TextTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="10"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
                <TextBox Text="{Binding Value}"
                         Grid.Column="1"
                         Width="100" 
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="20, 0, 0, 0"
                         FontFamily="Segoe Print"
                         FontWeight="Bold"/>
            </Grid>
        </DataTemplate>

        <!-- Template for dropdown -->
        <DataTemplate x:Key="DropdownTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           Margin="10"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Value}"
                          Grid.Column="1"
                          Width="150"/>
            </Grid>
        </DataTemplate>

        <!-- Template for sliders -->
        <DataTemplate x:Key="SliderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="10"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
                <Slider Grid.Column="1"
                        Minimum="{Binding Min}"
                        Maximum="{Binding Max}"
                        Value="{Binding Value}"
                        TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="true"
                        Width="100"
                        Margin="5"/>
                <TextBlock Text="{Binding displayValue}"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
            </Grid>
        </DataTemplate>

        <!-- Template for radiobuttons -->
        <DataTemplate x:Key="RadioButtonTemplate"  DataType="{x:Type common:Fields}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           Margin="10"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding Options}" Grid.Column="1"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              FontFamily="Segoe Print"
                              FontWeight="Bold">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                                         Click="checkedButton"
                                         Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         GroupName="{Binding bindName}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Template for numeric fields -->
        <DataTemplate x:Key="NumberTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="10"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
                <TextBox Text="{Binding Value}"
                         Grid.Column="1"
                         Width="100" 
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="20, 0, 0, 0"
                         FontFamily="Segoe Print"
                         FontWeight="Bold"/>
            </Grid>
        </DataTemplate>

        <!-- Binds templates to dynamic fields -->
        <common:FieldTemplateSelector x:Key="FieldTemplateSelector"
                                     TextTemplate="{StaticResource TextTemplate}"
                                     DropdownTemplate="{StaticResource DropdownTemplate}"
                                     RadioButtonTemplate="{StaticResource RadioButtonTemplate}"
                                     SliderTemplate="{StaticResource SliderTemplate}"
                                     NumberTemplate="{StaticResource NumberTemplate}"/>
    </Window.Resources>
    
    <!-- General Data Fields -->
    <Grid Background="DarkKhaki">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <GroupBox Header="General Mammal Data" Margin="5"
                  FontFamily="Arial Black"
                  BorderBrush="Black"
                  BorderThickness="2"
                  Background="BlanchedAlmond">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Number of teeth"
                       Grid.Column="0"
                       Grid.Row="0" FontFamily="Segoe Print"
                       FontWeight="Bold"/>

                <TextBox Grid.Column="1"
                         Grid.Row="0"
                         Width="69"
                         Height="20"
                         HorizontalAlignment="Center"
                         Name="teethBox"/>
                <Label Content="Fangs"
                       Grid.Column="0"
                       Grid.Row="1"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <RadioButton Content="Yes"
                             GroupName="fangs"
                             Grid.Column="1"
                             Grid.Row="1"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             FontFamily="Segoe Print"
                             FontWeight="Bold"
                             Name="fangsYes"/>
                <RadioButton Content="No"
                             Grid.Column="2"
                             GroupName="fangs"
                             Grid.Row="1"
                             FontFamily="Segoe Print"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Name="fangsNo"/>
                <Label Content="Color"
                       Grid.Column="0"
                       Grid.Row="2"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <TextBox Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Grid.Row="2"
                         Width="200"
                         Height="20"
                         Name="colorField"/>
            </Grid>
        </GroupBox>
        
        <!-- Specific Data Fields -->
        <GroupBox Grid.Row="1"
                  Header="Specific Data"
                  BorderBrush="Black"
                  BorderThickness="2" FontFamily="Arial Black"
                  Background="BlanchedAlmond"
                  Margin="5">
            <ItemsControl ItemsSource="{Binding Fields}"
                          ItemTemplateSelector="{StaticResource FieldTemplateSelector}"
                          Margin="10"/>
        </GroupBox>

        <!-- Buttons -->
        <Grid Grid.Row="2"
              Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Submit"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Click="createButton"
                    Width="100"
                    Height="30" FontFamily="Segoe Print"
                    Background="Crimson"
                    FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Cancel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Click="cancelClick"
                    Width="100"
                    Height="30" FontFamily="Segoe Print"
                    Background="Crimson"
                    FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </Grid>
    </Grid>
</Window>