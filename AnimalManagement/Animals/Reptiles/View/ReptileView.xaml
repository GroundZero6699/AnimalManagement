<Window x:Class="AnimalManagement.Animals.Reptiles.View.ReptileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:AnimalManagement.Animals.Common"
        xmlns:local="clr-namespace.AnimalManagement.Animals.Reptiles"
        mc:Ignorable="d"
        Title="ReptileView" Height="450" Width="400">

    <!-- Templates for specific data fields -->
    <Window.Resources>
        
        <!-- Template for textfields with label -->
        <DataTemplate x:Key="TextTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                       Grid.Column="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="10"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <TextBox Text="{Binding Value}"
                     Grid.Column="1"
                     Width="100" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="20, 0, 0, 0"
                     FontFamily="Segoe Print"
                     FontWeight="Bold"/>
            </Grid>
        </DataTemplate>

        <!-- template for dropdown and label -->
        <DataTemplate x:Key="DropdownTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                       Grid.Column="0"
                       Margin="10"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Value}"
                          Grid.Column="1"
                          Width="150"
                          Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Template for slider and label -->
        <DataTemplate x:Key="SliderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <Slider Grid.Column="1"
                    Minimum="{Binding Min}"
                    Maximum="{Binding Max}"
                    Value="{Binding Value}"
                    TickFrequency="{Binding Step}"
                    IsSnapToTickEnabled="true"
                    Width="100"
                    Margin="5"/>
                <TextBlock Text="{Binding displayValue}"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
            </Grid>
        </DataTemplate>

        <!-- Template for numbers with label -->
        <DataTemplate x:Key="NumberTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="10"
                           FontFamily="Segoe Print"
                           FontWeight="Bold"/>
                <TextBox Text="{Binding Value}"
                         Grid.Column="1"
                         Width="100" 
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="20, 0, 0, 0"
                         FontFamily="Segoe Print"
                         FontWeight="Bold"/>
            </Grid>
        </DataTemplate>

        <!-- Template for radiobuttons -->
        <DataTemplate x:Key="RadioButtonTemplate"  DataType="{x:Type common:Fields}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}"
                   Grid.Column="0"
                   Margin="10"
                   FontFamily="Segoe Print"
                   FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding Options}" Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      FontFamily="Segoe Print"
                      FontWeight="Bold">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                                 Click="checkedButton"
                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 GroupName="radioGroup"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- field binder for templates to resources -->
        <common:FieldTemplateSelector x:Key="FieldTemplateSelector"
                                 TextTemplate="{StaticResource TextTemplate}"
                                 DropdownTemplate="{StaticResource DropdownTemplate}"
                                 RadioButtonTemplate="{StaticResource RadioButtonTemplate}"
                                 SliderTemplate="{StaticResource SliderTemplate}"
                                 NumberTemplate="{StaticResource NumberTemplate}"/>
    </Window.Resources>

    <!-- Main Reptile view -->
    <Grid Background="DarkKhaki">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        
        <!-- General reptile data fields -->
        <GroupBox Header="General Reptile Data" Margin="5"
              FontFamily="Arial Black"
              BorderBrush="Black"
              BorderThickness="2"
              Background="BlanchedAlmond">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Body Length"
                       Grid.Column="0"
                       Grid.Row="0" FontFamily="Segoe Print"
                       FontWeight="Bold"/>

                <TextBox Grid.Column="1"
                         Grid.Row="0"
                         Width="65"
                         Height="20"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Name="lengthBox"/>
                <Label Content="Tail"
                       Grid.Column="0"
                       Grid.Row="1"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <RadioButton Content="Yes"
                             Grid.Column="1"
                             GroupName="tailCheck"
                             Grid.Row="1"
                             Name="tailYes"
                             FontFamily="Segoe Print"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"/>
                <RadioButton Content="No"
                             Grid.Column="2"
                             GroupName="tailCheck"
                             Name="tailNo"
                             Grid.Row="1"
                             FontFamily="Segoe Print"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"/>
                <Label Content="Natural Habitat"
                       Grid.Column="0"
                       Grid.Row="2"
                       FontFamily="Segoe Print"
                       FontWeight="Bold"/>
                <Slider Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Grid.Row="2"
                        Width="200"
                        Height="20"
                        Minimum="0"
                        Maximum="3"
                        ValueChanged="habitatSliderChanger"
                        Name="habitatSlider"/>
                <Label Grid.Row="3"
                       Grid.Column="1"
                       Content="Unknown Habitat"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Name="habitatLabel"
                       />
            </Grid>
        </GroupBox>
        
        <!-- Specific data fields -->
        <GroupBox Grid.Row="1"
          Header="Specific Data"
          BorderBrush="Black"
          BorderThickness="2" FontFamily="Arial Black"
          Background="BlanchedAlmond"
          Margin="5">
            <ItemsControl ItemsSource="{Binding Fields}"
                  ItemTemplateSelector="{StaticResource FieldTemplateSelector}"
                  Margin="10"/>
        </GroupBox>
        
        <!-- create button area -->
        <Grid Grid.Row="2"
              Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Submit"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Click="createButton"
                    Width="100"
                    Height="30" FontFamily="Segoe Print"
                    Background="Crimson"
                    FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Cancel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Click="cancelClick"
                    Width="100"
                    Height="30" FontFamily="Segoe Print"
                    Background="Crimson"
                    FontWeight="Bold">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </Grid>
    </Grid>
</Window>
