<Window x:Class="AnimalManagement.Manager.View.ChangeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalManagement.Manager.View"
        xmlns:common="clr-namespace:AnimalManagement.Animals.Common"
        mc:Ignorable="d"
        Title="ChangeView" Height="800" Width="800">

    <Window.Resources>

        <!-- Template for textfields -->
        <DataTemplate x:Key="TextTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="30"
                           FontSize="14"
                           FontFamily="Segoe Print"
                           FontWeight="ExtraBlack"/>
                <TextBox Text="{Binding Value}"
                         Tag="{Binding}"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Width="100" 
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="15"
                         FontFamily="Segoe Print"
                         FontWeight="ExtraBlack"
                         BorderBrush="Black"
                         BorderThickness="2"/>
            </Grid>
        </DataTemplate>

        <!-- Template for dropdown -->
        <DataTemplate x:Key="DropdownTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           Margin="30"
                           FontSize="14"
                           FontFamily="Segoe Print"
                           FontWeight="ExtraBlack"/>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Value}"
                          Tag="{Binding}"
                          Grid.Column="1"
                          Width="150"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          FontFamily="Segoe Print"
                          FontWeight="ExtraBlack"
                          FontSize="14"/>
            </Grid>
        </DataTemplate>

        <!-- Template for sliders -->
        <DataTemplate x:Key="SliderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="30, 0, 0, 0"
                           FontSize="14"
                           FontFamily="Segoe Print"
                           FontWeight="ExtraBlack"/>
                <Slider Grid.Column="1"
                        Minimum="{Binding Min}"
                        Maximum="{Binding Max}"
                        Value="{Binding Value, Mode=TwoWay}"
                        TickFrequency="{Binding Step}"
                        Tag="{Binding}"
                        IsSnapToTickEnabled="true"
                        Width="100"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding displayValue}"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="14"
                           FontStyle="Oblique"
                           FontFamily="Segoe Print"
                           FontWeight="ExtraBlack"/>
            </Grid>
        </DataTemplate>

        <!-- Template for radiobuttons -->
        <DataTemplate x:Key="RadioButtonTemplate"  DataType="{x:Type common:Fields}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           Margin="30, 0, 0, 0"
                           FontFamily="Segoe Print"
                           FontSize="14"
                           FontWeight="ExtraBlack"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <ItemsControl ItemsSource="{Binding Options}"
                              x:Name="RadioItems"
                              AlternationCount="1000"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="40, 30, 0, 0"
                              FontFamily="Segoe Print"
                              FontSize="14"
                              FontStyle="Italic"
                              FontWeight="ExtraBlack">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                                         Loaded="loaded"
                                         x:Name="radioButton"
                                         GroupName="{Binding DataContext.bindName,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Template for numeric fields -->
        <DataTemplate x:Key="NumberTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"
                           FontSize="14"
                           FontFamily="Segoe Print"
                           FontWeight="ExtraBlack"/>
                <TextBox Text="{Binding Value}"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Width="100" 
                         Height="25"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="5,30,30,30"
                         FontFamily="Segoe Print"
                         FontWeight="ExtraBlack"
                         BorderBrush="Black"
                         BorderThickness="2"/>
            </Grid>
        </DataTemplate>

        <!-- Binds templates to dynamic fields -->
        <common:FieldTemplateSelector x:Key="FieldTemplateSelector"
                                 TextTemplate="{StaticResource TextTemplate}"
                                 DropdownTemplate="{StaticResource DropdownTemplate}"
                                 RadioButtonTemplate="{StaticResource RadioButtonTemplate}"
                                 SliderTemplate="{StaticResource SliderTemplate}"
                                 NumberTemplate="{StaticResource NumberTemplate}"/>
    </Window.Resources>
    
    <Grid Background="DarkKhaki">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="0.01*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.8*"/>
            </Grid.RowDefinitions>
            
            <Label Grid.Column="0" Grid.Row="0" 
                   VerticalAlignment="Top" 
                   Margin="5, 10, 0, 0" 
                   FontFamily="Segoe Print" 
                   FontSize="16" FontWeight="Bold">General Data</Label>

            <Separator Grid.Column="0" Grid.Row="0" 
                       Grid.ColumnSpan="2"
                       Background="Black" 
                       Height="3"
                       VerticalAlignment="Bottom"/>
            
            <Label Content="Name:"
                   Grid.Column="0"
                   Grid.Row="1"
                   FontFamily="Segoe Print"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="10, 0, 0, 0"
                   FontWeight="ExtraBlack"/>

            <TextBox x:Name="nameField"
                     Grid.Column="1"
                     Grid.Row="1"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Width="150"
                     BorderBrush="Black"
                     BorderThickness="2"
                     Text="{Binding data.name}"/>

            <Label Content="Age:"
                   Grid.Column="0"
                   Grid.Row="2"
                   FontFamily="Segoe Print"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="10, 0, 0, 0"
                   FontWeight="ExtraBlack"/>

            <TextBox x:Name="ageField"
                     Grid.Column="1"
                     Grid.Row="2"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Width="50"
                     BorderBrush="Black"
                     BorderThickness="2"
                     Text="{Binding data.age}"/>

            <Label Content="Weight:"
                   Grid.Column="0"
                   Grid.Row="3"
                   FontFamily="Segoe Print"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="10, 0, 0, 0"
                   FontWeight="ExtraBlack"/>

            <TextBox x:Name="weightField"
                     Grid.Column="1"
                     Grid.Row="3"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Width="50"
                     BorderBrush="Black"
                     BorderThickness="2"
                     Text="{Binding data.weight}"/>

            <ComboBox Grid.Column="1" Grid.Row="4" 
                      VerticalAlignment="Center"
                      Width="150"
                      HorizontalAlignment="Left"
                      BorderBrush="Black"
                      BorderThickness="2" Name="genderBox"
                      ItemsSource="{Binding genders}"
                      SelectedItem="{Binding data.gender, Mode=TwoWay}"/>
            
            <Label Content="Gender:"
                   Grid.Column="0"
                   Grid.Row="4"
                   FontFamily="Segoe Print"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="10, 0, 0, 0"
                   FontWeight="ExtraBlack"/>
            
            

            <Image x:Name="imageField"
                   Grid.ColumnSpan="2"
                   Grid.Column="0"
                   Grid.Row="5"
                   Width="380"
                   Height="380"
                   VerticalAlignment="Top"
                   Margin="0, 20, 0, 0"
                   Source="{Binding data.image}"/>

            <Button x:Name="LoadImage"
                    Content="Load Image"
                    FontFamily="Segoe Print"
                    FontSize="14"
                    FontWeight="ExtraBlack"
                    Background="Crimson"
                    Grid.Column="0"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Height="30"
                    Width="100"
                    Margin="0, 0, 0, 10"
                    Click="loadNewImage">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </Grid>
        
        <StackPanel Orientation="Vertical"
                    Grid.Column="1"
                    Background="Black"/>
        
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.9*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.Row="0" 
                   VerticalAlignment="Top" 
                   Margin="5, 10, 0, 0" 
                   FontFamily="Segoe Print" 
                   FontSize="16" FontWeight="Bold">Species Data</Label>

            <Separator Grid.Column="0" Grid.Row="0" 
                       Grid.ColumnSpan="2"
                       Background="Black" 
                       Height="3"
                       VerticalAlignment="Bottom"/>

            <ItemsControl ItemsSource="{Binding SpeciesFields}"
                          ItemTemplateSelector="{StaticResource FieldTemplateSelector}"
                          Grid.Row="1"/>
            <Button x:Name="Submit"
                    Content="Submit"
                    Background="Crimson"
                    Grid.Row="2"
                    Height="30"
                    Width="80"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="100, 10, 0, 20"
                    FontSize="14"
                    FontFamily="Segoe Print"
                    FontWeight="ExtraBold"
                    FontStyle="Oblique"
                    Click="updateAnimal">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Cancel"
                    x:Name="cancelButton"
                    Grid.Row="2"
                    Width="80"
                    Height="30"
                    Margin="0, 0, 100, 20"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Background="Crimson"
                    FontFamily="Segoe Print"
                    FontSize="14"
                    FontWeight="ExtraBlack"
                    FontStyle="Oblique"
                    Click="cancelUpdate">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>

            </Button>
        </Grid>
    </Grid>
</Window>
