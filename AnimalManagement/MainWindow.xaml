<Window x:Class="AnimalManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalManagement" 
        xmlns:manager="clr-namespace:AnimalManagement.Manager"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1500"
        x:Name="root">
    <Grid Background="DarkKhaki">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="0.4*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        
        <!-- Simple MENU -->
        <Menu Grid.Row="0"
              Grid.ColumnSpan="3">
            <MenuItem Header="File">
                <MenuItem Header="New" Click="freshStart"/>
                <MenuItem Header="Open" Click="open"/>
                <MenuItem Header="Save As" Click="saveAs"/>
                <MenuItem Header="Save" Click="save"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="showHelp"/>
            </MenuItem>
            <MenuItem Header="Exit" Click="terminate"/>
        </Menu>
        
        <!-- Left side box top -->
        <Border Grid.Column="0"
                Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="0,0,1,0"
                Visibility="Hidden"
                Name="animalPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0.3*"/>
                </Grid.RowDefinitions>
                
                <Label Grid.Column="0" Grid.Row="0"
                       Margin="10, 30, 10, 0"
                       FontFamily="Segoe Print" ClipToBounds="True" FontSize="16" FontWeight="Bold">Animals</Label>
                
                <Separator Grid.ColumnSpan="2"
                           Grid.Row="0"
                           Height="3"
                           Background="Black"
                           Margin="85, 35, 0,0"/>

                <ListBox Grid.Column="0" Grid.Row="1"
                         Margin="10, 0, 10, 10"
                         FontFamily="Segoe Print" FontSize="14" x:Name="typeChooser"
                         SelectionChanged="animalChange"/>


                <CheckBox Grid.Column="1" Grid.Row="1" 
                          FontFamily="Segoe Print"
                          Margin="10, 0, 0, 0"
                          VerticalAlignment="Top" FontSize="14" 
                          RenderTransformOrigin="0.450,0.402" 
                          FontWeight="Bold"
                          Name="allAnimals"
                          Content="Show all animals"
                          Checked="showAllAnimals"
                          Unchecked="hideAnimals"/>

                <ListBox Grid.Column="1" Grid.Row="1"
                         Margin="10, 20, 10, 10" 
                         FontFamily="Segoe Print" FontSize="14"
                         Name="animalListBox"
                         SelectionChanged="animalChange"/>

                <Button Grid.ColumnSpan="2"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="200" Height="40" 
                        FontSize="18" 
                        FontFamily="Segoe Print"
                        Margin="10"
                        Background="Crimson" FontWeight="Bold"
                        Name="createAnimal"
                        Click="createNewAnimal">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect> Create Animal</Button>
                        
            </Grid>
        </Border>

        <!-- Right side box top -->
        <Border 
                Grid.Column="2"
                Grid.Row="1">
            <StackPanel Orientation="Vertical">
                <Image Height="200" Width="200" 
                       Margin="30" Name="imageBox"/>
                <Button Width="200" Height="40" 
                        FontSize="18" 
                        FontFamily="Segoe Print"
                        Margin="30"
                        Background="Crimson" FontWeight="Bold" Name="imageButton"
                        Click="loadImage">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect> Load Image
                </Button>
            </StackPanel>
        </Border>
        
        <!-- middle top box -->
        <Border Grid.Column="1"
                Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="0,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.3*"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" 
                       VerticalAlignment="Center" 
                       Margin="10, 0, 0, 0" FontFamily="Segoe Print" FontSize="16" FontWeight="Bold">General Data</Label>
                
                <Separator Grid.Column="1" Grid.Row="0" 
                           Background="Black" 
                           Height="3"
                           VerticalAlignment="Center"/>

                <Label Grid.Column="0"
                       Grid.Row="1"
                       VerticalAlignment="Center"
                       Margin="20, 0, 0, 0"
                       FontFamily="Segoe Print" FontSize="16">Name</Label>
                <TextBox Grid.Column="1"
                         Grid.Row="1"
                         VerticalAlignment="Center"
                         BorderBrush="Black"
                         BorderThickness="1"
                         Margin="0, 0, 100, 0"
                         Name="nameBox"/>

                <Label Grid.Column="0" Grid.Row="2" 
                       VerticalAlignment="Center" 
                       Margin="20, 0, 0, 0" FontFamily="Segoe Print" FontSize="16">Age</Label>
                <TextBox Grid.Column="1" Grid.Row="2" 
                         VerticalAlignment="Center"
                         BorderBrush="Black"
                         BorderThickness="1"
                         Margin="0, 0, 100, 0" Name="ageBox"/>
                <Label Grid.Column="0" Grid.Row="3" 
                       VerticalAlignment="Center" 
                       Margin="20, 0, 0, 0" FontFamily="Segoe Print" FontSize="16">Weight</Label>
                <TextBox Grid.Column="1" Grid.Row="3" 
                         VerticalAlignment="Center"
                         BorderBrush="Black"
                         BorderThickness="1"
                         Margin="0, 0, 100, 0" Name="weightBox"/>
                <Label Grid.Column="0" Grid.Row="4" 
                       VerticalAlignment="Center" 
                       Margin="20, 0, 0, 0" FontSize="16" FontFamily="Segoe Print">Gender</Label>
                <ComboBox Grid.Column="1" Grid.Row="4" 
                          VerticalAlignment="Center"
                          Width="250"
                          HorizontalAlignment="Left"
                          BorderBrush="Black"
                          BorderThickness="1" Name="genderBox"/>
                <Button Grid.Column="1"
                        Grid.Row="5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Width="200"
                        Height="40" FontFamily="Segoe Print" FontSize="18"
                        Background="Crimson" FontWeight="Bold" Name="addButton"
                        Click="showAnimalClick">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect> Add</Button>
            </Grid>
        </Border>
        
        <!-- Bottom middle box -->
        <Border Grid.Column="1"
                Grid.Row="2"
                BorderBrush="Black"
                BorderThickness="0, 2, 0, 0">
            <TextBox Margin="10" Name="animalInfo"
                     FontFamily="Segoe Print"
                     FontWeight="Bold"
                     BorderBrush="Black"
                     BorderThickness="2"
                     IsReadOnly="True"/>
        </Border>
        
        <!-- Left bottom box -->
        <Grid Grid.Row="2"
              Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>

            <Label Content="Animals"
                   Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Grid.Column="0"
                   Margin="8, 0, 0, 0"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   FontFamily="Segoe Print"
                   FontWeight="Bold"
                   FontSize="20"/>

            <ListView Margin="10, 0, 10, 10"
                     Grid.Row="1"
                     Grid.ColumnSpan="6"
                     FontFamily="Segoe Print"
                     FontWeight="Bold"
                     x:Name="listAnimals"
                     ItemsSource="{Binding ElementName=root, Path=manager.getAnimals}"
                     SelectedItem="{Binding ElementName=root, Path=change.selected}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Species" DisplayMemberBinding="{Binding species}" Width="120"/>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding id}" Width="50"/>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding name}" Width="110"/>
                        <GridViewColumn Header="Age" DisplayMemberBinding="{Binding age}" Width="80"/>
                        <GridViewColumn Header="Weight" DisplayMemberBinding="{Binding weight}" Width="70"/>
                        <GridViewColumn Header="Gender" DisplayMemberBinding="{Binding gender}" Width="120"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="changeButton"
                    Content="Update"
                    Background="Crimson"
                    FontFamily="Segoe Print"
                    FontSize="18"
                    Height="40"
                    Width="150"
                    Grid.ColumnSpan="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Grid.Column="0"
                    Grid.Row="2"
                    Click="changeAnimal">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Grid.Column="3"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Background="Crimson"
                    FontFamily="Segoe Print"
                    FontSize="18"
                    FontWeight="Bold"
                    Width="150"
                    Height="40"
                    VerticalAlignment="Center"
                    Content="Delete"
                    HorizontalAlignment="Center"
                    Click="deleteAnimal">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </Grid>
        <Border BorderBrush="Black"
                BorderThickness="0, 2, 0, 0"
                Grid.Column="2"
                Grid.Row="3">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="295"
                         Height="360"
                         Margin="0, 10, 0, 10"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Left"
                         BorderBrush="Black"
                         BorderThickness="2"
                         x:Name="infoBox"
                         FontFamily="Segoe Print"
                         FontStyle="Italic"
                         Text="{Binding ElementName=root, Path=change.selected.toInfoString, Mode=OneWay}">
                </TextBox>
                <Image Source="{Binding ElementName=root, Path=change.selected.image}"
                       Width="150"
                       Height="150"
                       Margin="10"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       x:Name="animalImage"/>
                    
            </StackPanel>
        </Border>
    </Grid>
</Window>
